# Modele des variables locales. Copier en local/.env (ignore par Git) et adapter.
# Lu par Docker Compose (local/compose.yaml) ET par l'API lancee depuis l'IDE (spring.config.import).
# Memes noms que la ConfigMap / les Secrets OpenShift (donation-api-config, donation-api-db-secret,
# donation-api-management-secret).
DB_HOST=localhost
DB_PORT=3307
DB_NAME=donation_api
DB_USER=donation_user
DB_PASSWORD=change-me-local
# Comptes des endpoints /management (basic auth) : ADMIN = tout, VIEWER = metrics/prometheus
MANAGEMENT_ADMIN_USER=admin-local
MANAGEMENT_ADMIN_PWD=change-me-local
MANAGEMENT_VIEWER_USER=viewer-local
MANAGEMENT_VIEWER_PWD=change-me-local
